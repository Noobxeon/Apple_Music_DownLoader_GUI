{
  "name": "apple_music",
  "version": "2.0.0",
  "description": "Apple Music Studio Downloader - 基于 Electron + Vue 3 + 内置 gamdl 3.9.1 的专业级音乐下载工作站",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --headless-smoke-test",
    "smoke:ui": "electron scripts/smoke-ui.cjs",
    "build:frontend": "cd frontend && npm run build",
    "build": "node scripts/check-bundle.js && npm run build:frontend && electron-builder",
    "test": "node --test tests/*.test.js",
    "build:engine": "python scripts/build-engine.py"
  },
  "build": {
    "appId": "com.music.downloader",
    "productName": "Apple Music 下载器",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apple Music 下载器"
    },
    "asarUnpack": [
      "backend/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "backend/**/*",
      "build/icon.ico",
      "build/icon.png",
      "frontend/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/gamdl-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Apple-Music-Downloader-${version}-${arch}.${ext}"
  },
  "keywords": [
    "apple-music",
    "downloader",
    "lossless",
    "alac",
    "electron",
    "vue3",
    "gamdl"
  ],
  "author": "NBXW",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  }
}
