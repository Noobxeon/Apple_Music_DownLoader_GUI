{
  "name": "apple_music",
  "version": "1.1.0",
  "description": "基于 Electron + Vue 3 的 Apple Music 下载器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.music.downloader",
    "productName": "Apple Music 下载器",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apple Music 下载器"
    },
    "asarUnpack": [
      "backend/**/*"
    ],
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "keywords": [
    "apple-music",
    "downloader",
    "electron",
    "vue3",
    "gamdl"
  ],
  "author": "NBXW",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "python-shell": "^5.0.0"
  }
}
